include ui-mixins

section(class='mx-auto w-full max-w-[var(--main-container)] px-[15px]')
	div(class='mx-auto w-full max-w-[var(--container)]')
		div(class='mx-auto max-w-lg')
			+uiPageHeader(registroData.title, registroData.lead)
			div(class='mt-6 grid gap-5 rounded-lg border border-[var(--border-soft)] bg-[var(--ageco-gray)] p-6')
				div(class='grid gap-2')
					label(class='text-sm font-semibold', for='reg-nombre') Nombre completo
					input#reg-nombre(
						class='rounded-md border border-[var(--border-soft)] bg-white px-3 py-2.5 text-sm outline-none focus:border-[var(--ageco-red)] focus:ring-2 focus:ring-[color-mix(in_srgb,var(--ageco-red)_25%,transparent)]',
						type='text',
						name='nombre',
						placeholder='Su nombre',
						autocomplete='off'
					)
				div(class='grid gap-2')
					label(class='text-sm font-semibold', for='reg-email') Correo electrónico
					input#reg-email(
						class='rounded-md border border-[var(--border-soft)] bg-white px-3 py-2.5 text-sm outline-none focus:border-[var(--ageco-red)] focus:ring-2 focus:ring-[color-mix(in_srgb,var(--ageco-red)_25%,transparent)]',
						type='text',
						name='email',
						placeholder='correo@ejemplo.com',
						autocomplete='off'
					)
				div(class='grid gap-2')
					label(class='text-sm font-semibold', for='reg-rol') Rol
					select#reg-rol(
						class='rounded-md border border-[var(--border-soft)] bg-white px-3 py-2.5 text-sm outline-none focus:border-[var(--ageco-red)] focus:ring-2 focus:ring-[color-mix(in_srgb,var(--ageco-red)_25%,transparent)]',
						name='rol'
					)
						each rol in registroData.roles
							option= rol
				div(class='grid gap-2')
					label(class='text-sm font-semibold', for='reg-password') Contraseña
					input#reg-password(
						class='rounded-md border border-[var(--border-soft)] bg-white px-3 py-2.5 text-sm outline-none focus:border-[var(--ageco-red)] focus:ring-2 focus:ring-[color-mix(in_srgb,var(--ageco-red)_25%,transparent)]',
						type='password',
						name='password',
						placeholder='••••••••',
						autocomplete='off'
					)
				+uiButton(registroData.submitLabel, registroData.submitHref, 'primary')
			p(class='mt-4 mb-0 text-sm text-[var(--ageco-gray-dark)]')
				= registroData.altLabel
				|
				a(class='ml-1 font-semibold text-[var(--ageco-red)]', href=registroData.altHref)= registroData.altLinkLabel
