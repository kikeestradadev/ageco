include ui-mixins

section#tabla(class='mx-auto w-full max-w-[var(--main-container)] px-[15px]')
	div(class='mx-auto w-full max-w-[var(--container)]')
		hr(class='mb-8 border-0 border-t-2 border-[var(--storybook-divider)]')
		h2(class='mb-2 font-display text-[length:var(--h2-size)] leading-[length:var(--h2-line)] font-bold') Tablas
		p(class='mb-8 text-[length:var(--p-size)] leading-[length:var(--p-line)] text-[var(--ageco-gray-dark)]')
			| Cabecera en Rojo AGECO, búsqueda, orden por columna, Excel, imprimir y WhatsApp. Datos desde
			code(class='mx-1 rounded bg-[var(--ageco-gray)] px-1') desempleados-data.json
			| .

		div(
			class='data-table',
			data-filename='ejemplo-tabla-style-guide',
			data-title='Ejemplo de tabla — Style Guide',
			data-page-size='10'
		)
			+dataTableToolbar('buscar-tabla-sg', 'Buscar en la tabla de ejemplo…')

			div(class='w-full overflow-x-auto rounded-lg border border-[var(--border-soft)]')
				table(
					class='w-full min-w-[40rem] border-collapse text-left text-[length:var(--p-size)] leading-[length:var(--p-line)] text-[var(--paragraph-color)]'
				)
					thead
						tr(class='bg-[var(--ageco-red)] text-white')
							+dataTableSortHeader('Nombre', 0)
							+dataTableSortHeader('Fecha de ingreso', 1)
							+dataTableSortHeader('Estado', 2)
							+dataTableSortHeader('Última capacitación', 3)
					tbody
						each item in desempleadosData.items.slice(0, 5)
							tr(class='border-t border-[var(--border-soft)] bg-white transition-colors [@media(hover:hover)_and_(pointer:fine)]:hover:bg-[var(--ageco-gray)]')
								td(class='px-4 py-3 whitespace-nowrap')
									a(class='font-semibold text-[var(--ageco-red)]', href=`./desempleado-perfil.html?id=${item.id}`)= item.nombre
								td(class='px-4 py-3 whitespace-nowrap')= item.fechaIngreso
								td(class='px-4 py-3 whitespace-nowrap')
									if item.estado === 'En seguimiento'
										+uiBadge(item.estado, 'success')
									else
										+uiBadge(item.estado, 'info')
								td(class='px-4 py-3 whitespace-nowrap')= item.ultimaCapacitacion
