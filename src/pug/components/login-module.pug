include ui-mixins

section(class='mx-auto w-full max-w-[var(--main-container)] px-[15px]')
	div(class='mx-auto w-full max-w-[var(--container)]')
		div(class='mx-auto max-w-lg')
			+uiPageHeader(loginData.title, loginData.lead)
			div(class='mt-6 grid gap-5 rounded-lg border border-[var(--border-soft)] bg-[var(--ageco-gray)] p-6')
				div(class='grid gap-2')
					label(class='text-sm font-semibold', for='login-email') Correo electrónico
					input#login-email(
						class='rounded-md border border-[var(--border-soft)] bg-white px-3 py-2.5 text-sm outline-none focus:border-[var(--ageco-red)] focus:ring-2 focus:ring-[color-mix(in_srgb,var(--ageco-red)_25%,transparent)]',
						type='text',
						name='email',
						placeholder='correo@ageco.org',
						autocomplete='off'
					)
				div(class='grid gap-2')
					label(class='text-sm font-semibold', for='login-password') Contraseña
					input#login-password(
						class='rounded-md border border-[var(--border-soft)] bg-white px-3 py-2.5 text-sm outline-none focus:border-[var(--ageco-red)] focus:ring-2 focus:ring-[color-mix(in_srgb,var(--ageco-red)_25%,transparent)]',
						type='password',
						name='password',
						placeholder='••••••••',
						autocomplete='off'
					)
				label(class='inline-flex items-center gap-2 text-sm')
					input(class='size-4 accent-[var(--ageco-red)]', type='checkbox', name='recordar')
					| Recordarme en este equipo
				+uiButton(loginData.submitLabel, loginData.submitHref, 'primary')
			p(class='mt-4 mb-0 text-sm text-[var(--ageco-gray-dark)]')
				= loginData.altLabel
				|
				a(class='ml-1 font-semibold text-[var(--ageco-red)]', href=loginData.altHref)= loginData.altLinkLabel
