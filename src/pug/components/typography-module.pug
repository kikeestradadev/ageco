section#tipografia(class='mx-auto w-full max-w-[var(--main-container)] px-[15px]')
	div(class='mx-auto w-full max-w-[var(--container)]')
		hr(class='mb-8 border-0 border-t-2 border-[var(--storybook-divider)]')
		h2(class='mb-2 font-display text-[length:var(--h2-size)] leading-[length:var(--h2-line)] font-bold') Tipografía
		p(class='mb-8 text-[length:var(--p-size)] leading-[length:var(--p-line)] text-[var(--ageco-gray-dark)]')
			| Principal:
			strong(class='mx-1') Arial
			|  (cuerpo). Secundaria:
			strong(class='mx-1') Roboto
			|  (títulos). Roboto se carga desde Google Fonts.

		div(class='mb-10 grid gap-8 m:grid-cols-2')
			div(class='rounded-lg border border-[var(--border-soft)] bg-[var(--ageco-gray)] p-6')
				p(class='mb-3 text-xs font-semibold tracking-wide text-[var(--sigo-green)] uppercase') Arial — cuerpo
				p(class='m-0 font-[family-name:var(--font-sans)] text-[length:var(--p-size)] leading-[length:var(--p-line)]')
					| El programa Sigo Vigente acompaña a personas adultas mayores en empleo y emprendimiento.
				p(class='mt-3 mb-0 font-[family-name:var(--font-sans)] text-sm font-bold') Peso bold en Arial
				p(class='mt-2 mb-0 font-[family-name:var(--font-sans)] text-[length:var(--small-size)] leading-[length:var(--small-line)] text-[var(--ageco-gray-dark)]') Texto pequeño / metadatos

			div(class='rounded-lg border border-[var(--border-soft)] bg-white p-6')
				p(class='mb-3 text-xs font-semibold tracking-wide text-[var(--ageco-red)] uppercase') Roboto — títulos
				h3(class='m-0 font-display text-2xl font-bold') Título destacado
				h4(class='mt-2 mb-0 font-display text-xl font-medium') Subtítulo medium
				p(class='mt-3 mb-0 font-display text-base font-light text-[var(--ageco-gray-dark)]') Variante light para apoyo

		h3(class='mb-4 font-display text-[length:var(--h3-size)] leading-[length:var(--h3-line)] font-semibold') Jerarquía tipográfica
		h1(class='font-display text-[length:var(--h1-size)] leading-[length:var(--h1-line)] font-bold') H1 — Panel de Control
		h2(class='font-display text-[length:var(--h2-size)] leading-[length:var(--h2-line)] font-bold') H2 — Desempleados en seguimiento
		h3(class='font-display text-[length:var(--h3-size)] leading-[length:var(--h3-line)] font-semibold') H3 — Actividad reciente
		h4(class='font-display text-[length:var(--h4-size)] leading-[length:var(--h4-line)] font-semibold') H4 — Detalle de perfil
		h5(class='font-display text-[length:var(--h5-size)] leading-[length:var(--h5-line)] font-semibold') H5 — Etiqueta de sección
		h6(class='font-display text-[length:var(--h6-size)] leading-[length:var(--h6-line)] font-semibold') H6 — Metadato
		p(class='mt-4 mb-2 text-[length:var(--p-size)] leading-[length:var(--p-line)] text-[var(--paragraph-color)]')
			| Párrafo de cuerpo con
			strong(class='mx-1') negrita
			| ,
			em(class='mx-1') cursiva
			|  y un
			a(class='mx-1', href='#') enlace de ejemplo
			| .
		small(class='block text-[length:var(--small-size)] leading-[length:var(--small-line)] text-[var(--ageco-gray-dark)]') Small — textos de ayuda, fechas y notas al pie.
