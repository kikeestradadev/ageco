block config
	- let currentPage = 'home';
	- let content = 'My Page';
	- let siteName = 'AGECO · Sigo Vigente';
	- let pageDescription = 'Prototipo CRM del programa Sigo Vigente de AGECO.';
doctype html
html(lang='es', prefix='og: http://ogp.me/ns#', class='no-js')
	head
		meta(charset='utf-8')
		meta(name='viewport', content='width=device-width, initial-scale=1')
		title= currentPage.slice(0, 1).toUpperCase() + currentPage.slice(1) + ' | ' + siteName
		meta(name='description', content=pageDescription)
		meta(name='robots', content='index, follow')
		link(rel='canonical', href='')
		meta(name='theme-color', content='#ED1B24')
		meta(name='format-detection', content='telephone=no')
		link(rel='icon', href='./assets/ageco-logo.png', type='image/png')
		include open-graph
		include twitter-cards
		link(rel='preconnect', href='https://fonts.googleapis.com')
		link(rel='preconnect', href='https://fonts.gstatic.com', crossorigin)
		link(
			href='https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,300;0,400;0,500;0,700;1,400&display=swap',
			rel='stylesheet'
		)
		link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css')
		link(rel='stylesheet', href=`./assets/prism.css?v=${assetVersion}`)
		link(rel='stylesheet', href=`styles.css?v=${assetVersion}`)
	body(
		class=`${currentPage} flex min-h-screen flex-col items-center bg-[var(--bg-body)] pt-[var(--header-height)] font-sans`,
		itemscope,
		itemtype='http://schema.org/WebPage'
	)
		include ../components/site-header
		main(class='flex w-full flex-1 flex-col max-w-[var(--main-container)] gap-[var(--section-gap)]')
			block main-container
		include ../components/site-footer
		include ../components/floating-button
		script(src='https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js')
		script(src=`index.js?v=${assetVersion}`)
		block scripts
