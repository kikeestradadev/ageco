include ui-mixins

section(class='mx-auto w-full max-w-[var(--main-container)] px-[15px]')
	div(class='mx-auto w-full max-w-[var(--container)]')
		+uiPageHeader(emprendedoresData.title, emprendedoresData.lead)
			+uiButton('Agregar Emprendedor', './emprendedor-formulario.html', 'primary')
			button(
				class='inline-flex items-center justify-center gap-2 rounded-md border-2 border-[var(--border-soft)] bg-white px-5 py-3 text-sm font-semibold text-[var(--ageco-black)]',
				type='button',
				data-entity-reset='emprendedores'
			) Restaurar demo

section(class='mx-auto w-full max-w-[var(--main-container)] px-[15px]')
	div(class='mx-auto w-full max-w-[var(--container)]')
		script#seed-emprendedores(type='application/json')!= JSON.stringify(emprendedoresData)

		div(class='mb-4', data-entity-banner-host='true')
			p(class='m-0 text-sm text-[var(--ageco-gray-dark)]')
				| Datos sembrados desde JSON + bucket local.
				span(class='ml-1 font-semibold', data-entity-count) —

		div(
			class='data-table',
			data-entity-list='emprendedores',
			data-filename='emprendedores-sigo-vigente',
			data-title='Emprendedores — Sigo Vigente',
			data-page-size='10'
		)
			+dataTableToolbar('buscar-emprendedor', 'Buscar por nombre, negocio, etapa…')

			div(class='w-full overflow-x-auto rounded-lg border border-[var(--border-soft)]')
				table(
					class='w-full min-w-[56rem] border-collapse text-left text-[length:var(--p-size)] leading-[length:var(--p-line)]'
				)
					thead
						tr(class='bg-[var(--ageco-red)] text-white')
							+dataTableSortHeader('Nombre', 0)
							+dataTableSortHeader('Negocio', 1)
							+dataTableSortHeader('Etapa', 2)
							+dataTableSortHeader('Estado', 3)
							+dataTableSortHeader('Próxima asesoría', 4)
					tbody
						each item in emprendedoresData.items.slice(0, 10)
							tr(class='border-t border-[var(--border-soft)] bg-white')
								td(class='px-4 py-3 whitespace-nowrap')= item.nombre
								td(class='px-4 py-3')= item.negocio
								td(class='px-4 py-3 whitespace-nowrap')= item.etapa
								td(class='px-4 py-3 whitespace-nowrap')= item.estado
								td(class='px-4 py-3 whitespace-nowrap')= item.proximaAsesoria
