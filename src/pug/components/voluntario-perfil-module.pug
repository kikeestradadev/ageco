include ui-mixins

-
	const voluntarioDefault = voluntariosData.items[0]

section(class='perfil-detalle mx-auto w-full max-w-[var(--main-container)] px-[15px]', data-perfil-tipo='voluntario')
	div(class='mx-auto w-full max-w-[var(--container)]')
		script#perfil-data(type='application/json')!= JSON.stringify(voluntariosData.items)

		div(class='mb-6')
			a(
				class='text-sm font-semibold text-[var(--ageco-red)] no-underline [@media(hover:hover)_and_(pointer:fine)]:hover:underline',
				href='./voluntarios.html'
			) ← Volver a Voluntarios

		+uiPageHeader(voluntarioDefault.nombre, 'Perfil de voluntariado — Sigo Vigente')

section(class='mx-auto w-full max-w-[var(--main-container)] px-[15px]')
	div(class='mx-auto grid w-full max-w-[var(--container)] gap-6 lg:grid-cols-2')
		article(class='rounded-lg border border-[var(--border-soft)] bg-white p-6 shadow-sm')
			h2(class='mb-4 font-display text-[length:var(--h3-size)] leading-[length:var(--h3-line)] font-semibold') Datos del voluntario
			dl(class='m-0 grid gap-4 sm:grid-cols-2')
				div
					dt(class='text-xs font-semibold tracking-wide text-[var(--ageco-gray-dark)] uppercase') Nombre
					dd(class='m-0 mt-1 font-semibold', data-field='nombre')= voluntarioDefault.nombre
				div
					dt(class='text-xs font-semibold tracking-wide text-[var(--ageco-gray-dark)] uppercase') Tipo
					dd(class='m-0 mt-1', data-field='tipo')= voluntarioDefault.tipo
				div
					dt(class='text-xs font-semibold tracking-wide text-[var(--ageco-gray-dark)] uppercase') Correo
					dd(class='m-0 mt-1', data-field='email')= voluntarioDefault.email
				div
					dt(class='text-xs font-semibold tracking-wide text-[var(--ageco-gray-dark)] uppercase') Teléfono
					dd(class='m-0 mt-1', data-field='telefono')= voluntarioDefault.telefono
				div
					dt(class='text-xs font-semibold tracking-wide text-[var(--ageco-gray-dark)] uppercase') Horas totales
					dd(class='m-0 mt-1 font-display text-2xl font-bold text-[var(--sigo-green)]', data-field='horasTotales')= voluntarioDefault.horasTotales
				div
					dt(class='text-xs font-semibold tracking-wide text-[var(--ageco-gray-dark)] uppercase') Estado
					dd(class='m-0 mt-1', data-field='estado')= voluntarioDefault.estado

		article(class='rounded-lg border border-[var(--border-soft)] bg-[var(--ageco-gray)] p-6')
			h2(class='mb-4 font-display text-[length:var(--h3-size)] leading-[length:var(--h3-line)] font-semibold') Personas asesoradas
			ul(class='m-0 list-disc space-y-2 pl-5 text-sm', data-list='asesorados')
				each nombre in voluntarioDefault.asesorados
					li= nombre

section(class='mx-auto w-full max-w-[var(--main-container)] px-[15px]')
	div(class='mx-auto grid w-full max-w-[var(--container)] gap-6 lg:grid-cols-2')
		article(class='rounded-lg border border-[var(--border-soft)] bg-white p-5')
			h3(class='mb-3 text-base font-semibold text-[var(--sigo-green)]') Historial de asesorías
			ul(class='m-0 list-none space-y-3 p-0', data-list='historialAsesorias')
				each item in voluntarioDefault.historialAsesorias
					li(class='rounded-md border border-[var(--border-soft)] bg-[var(--ageco-gray)] p-3 text-sm')
						p(class='m-0 font-semibold')= item.persona
						p(class='m-0 text-[var(--ageco-gray-dark)]')= item.tema
						time(class='text-xs text-[var(--ageco-gray-dark)]')= item.fecha
		article(class='rounded-lg border border-[var(--border-soft)] bg-white p-5')
			h3(class='mb-3 text-base font-semibold text-[var(--sigo-green)]') Capacitaciones impartidas
			ul(class='m-0 list-disc space-y-2 pl-5 text-sm', data-list='capacitacionesImpartidas')
				each c in voluntarioDefault.capacitacionesImpartidas
					li= c
