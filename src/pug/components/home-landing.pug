include ui-mixins

section(class='mx-auto w-full max-w-[var(--main-container)] px-[15px]')
	div(class='mx-auto w-full max-w-[var(--container)]')
		div(
			class='relative overflow-hidden rounded-2xl border border-[var(--border-soft)] bg-[linear-gradient(135deg,var(--ageco-gray)_0%,white_45%,color-mix(in_srgb,var(--sigo-green)_10%,white)_100%)] px-6 py-10 m:px-12 m:py-14'
		)
			div(
				class='pointer-events-none absolute inset-y-0 right-0 w-1/3 bg-[radial-gradient(circle_at_top_right,color-mix(in_srgb,var(--ageco-red)_18%,transparent),transparent_70%)]'
			)
			div(class='relative max-w-2xl')
				p(class='m-0 text-sm font-semibold tracking-wide text-[var(--sigo-green)] uppercase')= homeLandingData.eyebrow
				h1(class='mt-3 mb-0 font-display text-[length:var(--h1-size)] leading-[length:var(--h1-line)] font-bold text-[var(--ageco-black)]')= homeLandingData.title
				p(class='mt-2 mb-0 font-display text-[length:var(--h2-size)] leading-[length:var(--h2-line)] font-semibold text-[var(--ageco-red)]')= homeLandingData.subtitle
				p(class='mt-5 mb-0 max-w-xl text-[length:var(--p-size)] leading-[length:var(--p-line)] text-[var(--ageco-gray-dark)]')= homeLandingData.lead
				div(class='mt-8 flex flex-wrap gap-3')
					+uiButton(homeLandingData.primaryCta.label, homeLandingData.primaryCta.href, 'primary')
					+uiButton(homeLandingData.secondaryCta.label, homeLandingData.secondaryCta.href, 'secondary')
					+uiButton(homeLandingData.tertiaryCta.label, homeLandingData.tertiaryCta.href, 'outline')

section(class='mx-auto w-full max-w-[var(--main-container)] px-[15px]')
	div(class='mx-auto w-full max-w-[var(--container)]')
		h2(class='m-0 font-display text-[length:var(--h2-size)] leading-[length:var(--h2-line)] font-bold')= homeLandingData.aboutTitle
		p(class='mt-3 mb-8 max-w-3xl text-[length:var(--p-size)] leading-[length:var(--p-line)] text-[var(--ageco-gray-dark)]')= homeLandingData.aboutLead
		div(class='grid gap-5 m:grid-cols-3')
			each pillar in homeLandingData.pillars
				article(class='rounded-lg border border-[var(--border-soft)] bg-white p-6 shadow-sm')
					h3(class='m-0 font-display text-[length:var(--h3-size)] leading-[length:var(--h3-line)] font-semibold text-[var(--sigo-green)]')= pillar.title
					p(class='mt-3 mb-0 text-[length:var(--p-size)] leading-[length:var(--p-line)] text-[var(--paragraph-color)]')= pillar.text

section(class='mx-auto w-full max-w-[var(--main-container)] px-[15px]')
	div(class='mx-auto w-full max-w-[var(--container)]')
		div(class='grid gap-8 rounded-lg bg-[var(--ageco-gray)] p-6 m:grid-cols-2 m:p-10')
			div
				h2(class='m-0 font-display text-[length:var(--h2-size)] leading-[length:var(--h2-line)] font-bold')= homeLandingData.highlightsTitle
				ul(class='mt-5 mb-0 list-disc space-y-2 pl-5 text-[length:var(--p-size)] leading-[length:var(--p-line)]')
					each item in homeLandingData.highlights
						li= item
			div
				h2(class='m-0 font-display text-[length:var(--h2-size)] leading-[length:var(--h2-line)] font-bold')= homeLandingData.closingTitle
				p(class='mt-3 mb-6 text-[length:var(--p-size)] leading-[length:var(--p-line)] text-[var(--ageco-gray-dark)]')= homeLandingData.closingLead
				div(class='flex flex-wrap gap-3')
					+uiButton(homeLandingData.primaryCta.label, homeLandingData.primaryCta.href, 'primary')
					+uiButton(homeLandingData.secondaryCta.label, homeLandingData.secondaryCta.href, 'outline')
