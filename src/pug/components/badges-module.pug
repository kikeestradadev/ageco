include ui-mixins

section#badges(class='mx-auto w-full max-w-[var(--main-container)] px-[15px]')
	div(class='mx-auto w-full max-w-[var(--container)]')
		hr(class='mb-8 border-0 border-t-2 border-[var(--storybook-divider)]')
		h2(class='mb-2 font-display text-[length:var(--h2-size)] leading-[length:var(--h2-line)] font-bold') Badges / Etiquetas
		p(class='mb-8 text-[length:var(--p-size)] leading-[length:var(--p-line)] text-[var(--ageco-gray-dark)]')
			| Estados del programa y categorías. Verde petróleo para seguimiento activo; rojo para alertas o inactivo.

		h3(class='mb-3 font-display text-[length:var(--h3-size)] leading-[length:var(--h3-line)] font-semibold') Estados
		div(class='mb-8 flex flex-wrap gap-3')
			+uiBadge('En seguimiento', 'success')
			+uiBadge('Con empleo', 'info')
			+uiBadge('Activo', 'success')
			+uiBadge('Inactivo', 'danger')

		h3(class='mb-3 font-display text-[length:var(--h3-size)] leading-[length:var(--h3-line)] font-semibold') Categorías
		div(class='flex flex-wrap gap-3')
			+uiBadge('Empleo', 'outline')
			+uiBadge('Emprendimiento', 'outline')
			+uiBadge('Incubación', 'warning')
			+uiBadge('Capacitación', 'neutral')
