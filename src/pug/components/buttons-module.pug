include ui-mixins

section#botones(class='mx-auto w-full max-w-[var(--main-container)] px-[15px]')
	div(class='mx-auto w-full max-w-[var(--container)]')
		hr(class='mb-8 border-0 border-t-2 border-[var(--storybook-divider)]')
		h2(class='mb-2 font-display text-[length:var(--h2-size)] leading-[length:var(--h2-line)] font-bold') Botones
		p(class='mb-8 text-[length:var(--p-size)] leading-[length:var(--p-line)] text-[var(--ageco-gray-dark)]')
			| Primario en Rojo AGECO, secundario en Verde Sigo Vigente, outline y deshabilitado.

		div(class='flex flex-wrap items-center gap-4')
			+uiButton('Primario', '#', 'primary')
			+uiButton('Secundario', '#', 'secondary')
			+uiButton('Outline', '#', 'outline')
			+uiButton('Deshabilitado', null, 'disabled')

		p(class='mt-6 mb-0 text-sm text-[var(--ageco-gray-dark)]')
			| Tokens:
			code(class='mx-1 rounded bg-[var(--ageco-gray)] px-1') --btn-primary
			|  /
			code(class='mx-1 rounded bg-[var(--ageco-gray)] px-1') --btn-secondary
