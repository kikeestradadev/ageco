mixin styleGuideNavLink(item, variant)
	-
		const baseClass = 'style-guide-container__nav-link group flex items-center justify-between gap-3 no-underline transition-[background-color,color] duration-200'
		const desktopClass = 'rounded-md px-[0.85rem] py-[0.65rem] text-[0.9375rem] font-medium text-[var(--paragraph-color)] [@media(hover:hover)_and_(pointer:fine)]:hover:bg-black/5 [@media(hover:hover)_and_(pointer:fine)]:hover:no-underline [&.is-active]:font-bold [&.is-active]:text-[var(--ageco-red)]'
		const mobileClass = 'rounded-none border-b border-white/10 px-1 py-[0.85rem] text-[0.9375rem] font-medium text-gray-200 [@media(hover:hover)_and_(pointer:fine)]:hover:bg-transparent [@media(hover:hover)_and_(pointer:fine)]:hover:text-white [@media(hover:hover)_and_(pointer:fine)]:hover:no-underline [&.is-active]:font-bold [&.is-active]:text-[var(--ageco-red)]'
		const chevron = 'size-[0.4rem] shrink-0 rotate-[-45deg] border-r-2 border-b-2 border-transparent opacity-0 transition group-[.is-active]:border-current group-[.is-active]:opacity-100'
	a(class=`${baseClass} ${variant === 'mobile' ? mobileClass : desktopClass}`, href=item.href)
		= item.label
		span(class=chevron, aria-hidden='true')

section(class='style-guide-container group mx-auto w-full max-w-[var(--main-container)] px-[15px]')
	div(class='mx-auto w-full max-w-[var(--container)]')
		div(class='mb-2')
			p(class='mb-2 text-sm font-semibold tracking-wide text-[var(--sigo-green)] uppercase') Guía de marca
			h1(class='m-0 font-display text-[length:var(--h1-size)] leading-[length:var(--h1-line)] font-bold') Style Guide · AGECO / Sigo Vigente
			p(class='mt-3 mb-0 max-w-3xl text-[length:var(--p-size)] leading-[length:var(--p-line)] text-[var(--ageco-gray-dark)]')
				| Fuente de verdad visual del prototipo CRM. Valide colores, tipografía, logos y componentes antes de revisar el resto de pantallas.

		div(class='grid gap-8 l:grid-cols-[14rem_minmax(0,1fr)] l:items-start l:gap-12')
			nav(
				class='style-guide-container__nav style-guide-container__nav--desktop sticky hidden rounded-lg bg-[var(--ageco-gray)] p-3 l:block top-[calc(var(--header-height)+1rem)]',
				aria-label='Style guide'
			)
				ul(class='style-guide-container__nav-list m-0 flex list-none flex-col gap-1 p-0')
					each item in styleGuideNavData.items
						li(class='style-guide-container__nav-item m-0')
							+styleGuideNavLink(item, 'desktop')

			div(
				class='style-guide-container__content flex min-w-0 flex-col gap-[var(--section-gap)] [&_section]:scroll-mt-[calc(var(--header-height)+1rem)]'
			)
				include color-table
				include typography-module
				include logos-module
				include buttons-module
				include badges-module
				include cards-module
				include forms-module
				include table-module
				include alerts-module
				include navigation-module

	div(class='style-guide-container__mobile l:hidden')
		div#style-guide-panel(
			class='style-guide-container__panel fixed right-4 bottom-[5.5rem] z-[120] flex max-h-[min(70vh,32rem)] w-[min(20rem,calc(100vw-2rem))] flex-col overflow-hidden rounded-xl bg-[#2d3e4f] p-4 shadow-[0_16px_40px_rgba(0,0,0,0.28)]',
			hidden
		)
			p(class='style-guide-container__panel-title mb-3 text-[0.9375rem] font-semibold text-[#c5cdd6]')= styleGuideNavData.panelTitle
			nav(class='style-guide-container__nav style-guide-container__nav--mobile', aria-label='Style guide móvil')
				ul(
					class='style-guide-container__nav-list m-0 flex max-h-[min(55vh,26rem)] list-none flex-col gap-1 overflow-y-auto p-0 pr-1'
				)
					each item in styleGuideNavData.items
						li(class='style-guide-container__nav-item m-0')
							+styleGuideNavLink(item, 'mobile')

		button(
			class='style-guide-container__fab fixed right-4 bottom-4 z-[130] inline-flex size-14 cursor-pointer items-center justify-center rounded-full border-0 bg-[var(--ageco-red)] text-white shadow-[0_8px_24px_rgba(237,27,36,0.35)] transition-[transform,background-color,box-shadow] duration-200 focus-visible:outline focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-[var(--sigo-green)] [@media(hover:hover)_and_(pointer:fine)]:hover:-translate-y-0.5 [@media(hover:hover)_and_(pointer:fine)]:hover:bg-[var(--ageco-red-alt)]',
			type='button',
			aria-expanded='false',
			aria-controls='style-guide-panel',
			aria-label='Abrir navegación del style guide'
		)
			span(
				class='style-guide-container__fab-icon style-guide-container__fab-icon--open absolute text-[1.75rem] leading-none font-normal group-[.is-nav-open]:hidden',
				aria-hidden='true'
			) +
			span(
				class='style-guide-container__fab-icon style-guide-container__fab-icon--close absolute hidden text-[2rem] leading-none font-normal group-[.is-nav-open]:block',
				aria-hidden='true'
			) ×
