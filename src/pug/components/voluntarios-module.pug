include ui-mixins

section(class='mx-auto w-full max-w-[var(--main-container)] px-[15px]')
	div(class='mx-auto w-full max-w-[var(--container)]')
		+uiPageHeader(voluntariosData.title, voluntariosData.lead)
			+uiButton('Agregar Voluntario', './voluntario-formulario.html', 'primary')
			button(
				class='inline-flex items-center justify-center gap-2 rounded-md border-2 border-[var(--border-soft)] bg-white px-5 py-3 text-sm font-semibold text-[var(--ageco-black)]',
				type='button',
				data-entity-reset='voluntarios'
			) Restaurar demo

section(class='mx-auto w-full max-w-[var(--main-container)] px-[15px]')
	div(class='mx-auto w-full max-w-[var(--container)]')
		script#seed-voluntarios(type='application/json')!= JSON.stringify(voluntariosData)

		div(class='mb-4', data-entity-banner-host='true')
			p(class='m-0 text-sm text-[var(--ageco-gray-dark)]')
				| Datos sembrados desde JSON + bucket local.
				span(class='ml-1 font-semibold', data-entity-count) —

		div(
			class='data-table',
			data-entity-list='voluntarios',
			data-filename='voluntarios-sigo-vigente',
			data-title='Voluntarios — Sigo Vigente',
			data-page-size='10'
		)
			+dataTableToolbar('buscar-voluntario', 'Buscar por nombre, tipo, estado…')

			div(class='w-full overflow-x-auto rounded-lg border border-[var(--border-soft)]')
				table(
					class='w-full min-w-[48rem] border-collapse text-left text-[length:var(--p-size)] leading-[length:var(--p-line)]'
				)
					thead
						tr(class='bg-[var(--ageco-red)] text-white')
							+dataTableSortHeader('Nombre', 0)
							+dataTableSortHeader('Tipo', 1)
							+dataTableSortHeader('Horas registradas', 2)
							+dataTableSortHeader('Número de asesorados', 3)
							+dataTableSortHeader('Estado', 4)
					tbody
						each item in voluntariosData.items.slice(0, 10)
							tr(class='border-t border-[var(--border-soft)] bg-white')
								td(class='px-4 py-3 whitespace-nowrap')= item.nombre
								td(class='px-4 py-3 whitespace-nowrap')= item.tipo
								td(class='px-4 py-3 whitespace-nowrap')= item.horasTotales
								td(class='px-4 py-3 whitespace-nowrap')= item.asesorados.length
								td(class='px-4 py-3 whitespace-nowrap')= item.estado
