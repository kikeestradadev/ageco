include ui-mixins

-
	const inputClass = 'w-full rounded-md border border-[var(--border-soft)] bg-white px-3 py-2.5 text-sm outline-none focus:border-[var(--ageco-red)] focus:ring-2 focus:ring-[color-mix(in_srgb,var(--ageco-red)_25%,transparent)]'

section(class='mx-auto w-full max-w-[var(--main-container)] px-[15px]')
	div(class='mx-auto w-full max-w-[var(--container)]')
		a(
			class='mb-4 inline-flex text-sm font-semibold text-[var(--ageco-red)] no-underline [@media(hover:hover)_and_(pointer:fine)]:hover:underline',
			href='./voluntarios.html'
		) ← Volver a Voluntarios
		+uiPageHeader(
			'Agregar Voluntario',
			'Formulario con validación. Al guardar, el registro se agrega al bucket local sembrado desde voluntarios-data.json.'
		)

section(class='mx-auto w-full max-w-[var(--main-container)] px-[15px]')
	div(class='mx-auto w-full max-w-[var(--container)]')
		script#seed-voluntarios(type='application/json')!= JSON.stringify(voluntariosData)
		form(
			class='entity-form grid max-w-3xl gap-5 rounded-lg border border-[var(--border-soft)] bg-[var(--ageco-gray)] p-6',
			action='#',
			method='get',
			data-entity-form='voluntarios'
		)
			div(class='grid gap-5 m:grid-cols-2')
				div(class='grid gap-2')
					label(class='text-sm font-semibold', for='nombre') Nombre completo *
					input#nombre(class=inputClass, type='text', name='nombre', placeholder='Nombre y apellidos')
				div(class='grid gap-2')
					label(class='text-sm font-semibold', for='email') Correo electrónico *
					input#email(class=inputClass, type='email', name='email', placeholder='voluntario@ageco.org')
				div(class='grid gap-2')
					label(class='text-sm font-semibold', for='telefono') Teléfono *
					input#telefono(class=inputClass, type='tel', name='telefono', placeholder='8666-0000')
				div(class='grid gap-2')
					label(class='text-sm font-semibold', for='tipo') Tipo *
					select#tipo(class=inputClass, name='tipo')
						option(value='Empleo') Empleo
						option(value='Emprendimiento') Emprendimiento
				div(class='grid gap-2')
					label(class='text-sm font-semibold', for='horasTotales') Horas registradas *
					input#horasTotales(class=inputClass, type='number', name='horasTotales', min='0', step='1', value='0')
				div(class='grid gap-2')
					label(class='text-sm font-semibold', for='estado') Estado
					select#estado(class=inputClass, name='estado')
						option(value='Activo') Activo
						option(value='Inactivo') Inactivo
				div(class='grid gap-2 m:col-span-2')
					label(class='text-sm font-semibold', for='asesorados') Personas asesoradas
					input#asesorados(
						class=inputClass,
						type='text',
						name='asesorados',
						placeholder='Separar nombres con comas'
					)
				div(class='grid gap-2 m:col-span-2')
					label(class='text-sm font-semibold', for='capacitacion') Capacitación impartida
					input#capacitacion(
						class=inputClass,
						type='text',
						name='capacitacion',
						placeholder='Ej. Preparación para el Empleo'
					)

			div(class='flex flex-wrap gap-3')
				button(
					class='inline-flex items-center justify-center rounded-md border-2 border-[var(--btn-primary)] bg-[var(--btn-primary)] px-5 py-3 text-sm font-semibold text-white',
					type='button',
					data-entity-save='true'
				) Guardar en bucket
				+uiButton('Cancelar', './voluntarios.html', 'outline')
