//- Mixins reutilizables AGECO / Sigo Vigente

mixin uiButton(label, href, variant, attrs)
	-
		const variants = {
			primary: 'inline-flex items-center justify-center gap-2 rounded-md border-2 border-[var(--btn-primary)] bg-[var(--btn-primary)] px-5 py-3 text-sm font-semibold text-[var(--btn-text)] no-underline transition-[background-color,border-color] duration-200 [@media(hover:hover)_and_(pointer:fine)]:hover:border-[var(--btn-primary-hover)] [@media(hover:hover)_and_(pointer:fine)]:hover:bg-[var(--btn-primary-hover)] [@media(hover:hover)_and_(pointer:fine)]:hover:no-underline',
			secondary: 'inline-flex items-center justify-center gap-2 rounded-md border-2 border-[var(--btn-secondary)] bg-[var(--btn-secondary)] px-5 py-3 text-sm font-semibold text-[var(--btn-text)] no-underline transition-[background-color,border-color] duration-200 [@media(hover:hover)_and_(pointer:fine)]:hover:border-[var(--btn-secondary-hover)] [@media(hover:hover)_and_(pointer:fine)]:hover:bg-[var(--btn-secondary-hover)] [@media(hover:hover)_and_(pointer:fine)]:hover:no-underline',
			outline: 'inline-flex items-center justify-center gap-2 rounded-md border-2 border-[var(--ageco-red)] bg-transparent px-5 py-3 text-sm font-semibold text-[var(--ageco-red)] no-underline transition-[background-color,color] duration-200 [@media(hover:hover)_and_(pointer:fine)]:hover:bg-[var(--ageco-red)] [@media(hover:hover)_and_(pointer:fine)]:hover:text-white [@media(hover:hover)_and_(pointer:fine)]:hover:no-underline',
			disabled: 'inline-flex cursor-not-allowed items-center justify-center gap-2 rounded-md border-2 border-[var(--ageco-gray-mid)] bg-[var(--ageco-gray-mid)] px-5 py-3 text-sm font-semibold text-[var(--ageco-gray-dark)] no-underline opacity-70',
		}
		const className = variants[variant] || variants.primary
	if variant === 'disabled'
		button(class=className, type='button', disabled)= label
	else if href
		a(class=className, href=href)&attributes(attrs)= label
	else
		button(class=className, type='button')&attributes(attrs)= label

mixin uiBadge(label, tone)
	-
		const tones = {
			success: 'inline-flex items-center rounded-full bg-[var(--sigo-green)] px-3 py-1 text-xs font-semibold text-white',
			danger: 'inline-flex items-center rounded-full bg-[var(--ageco-red)] px-3 py-1 text-xs font-semibold text-white',
			neutral: 'inline-flex items-center rounded-full bg-[var(--ageco-gray-dark)] px-3 py-1 text-xs font-semibold text-white',
			outline: 'inline-flex items-center rounded-full border border-[var(--sigo-green)] bg-white px-3 py-1 text-xs font-semibold text-[var(--sigo-green)]',
			warning: 'inline-flex items-center rounded-full bg-[var(--ageco-amber)] px-3 py-1 text-xs font-semibold text-white',
			info: 'inline-flex items-center rounded-full bg-[var(--ageco-info)] px-3 py-1 text-xs font-semibold text-white',
		}
		const badgeClass = tones[tone] || tones.neutral
	span(class=badgeClass)= label

mixin uiAlert(title, message, tone)
	-
		const alerts = {
			success: 'border-[var(--sigo-green)] bg-[color-mix(in_srgb,var(--sigo-green)_12%,white)] text-[var(--sigo-green-alt)]',
			error: 'border-[var(--ageco-red)] bg-[color-mix(in_srgb,var(--ageco-red)_12%,white)] text-[var(--ageco-red-alt)]',
			warning: 'border-[var(--ageco-amber)] bg-[color-mix(in_srgb,var(--ageco-amber)_12%,white)] text-[#92400e]',
			info: 'border-[var(--ageco-info)] bg-[color-mix(in_srgb,var(--ageco-info)_12%,white)] text-[#0c4a6e]',
		}
		const alertClass = alerts[tone] || alerts.info
	div(class=`rounded-md border-l-4 p-4 ${alertClass}`, role='status')
		p(class='m-0 text-sm font-semibold')= title
		if message
			p(class='mt-1 mb-0 text-sm')= message

mixin uiPageHeader(title, lead)
	div(class='flex flex-col gap-3 m:flex-row m:items-end m:justify-between')
		div(class='min-w-0')
			h1(class='m-0 font-display text-[length:var(--h1-size)] leading-[length:var(--h1-line)] font-bold text-[var(--ageco-black)]')= title
			if lead
				p(class='mt-2 mb-0 max-w-3xl text-[length:var(--p-size)] leading-[length:var(--p-line)] text-[var(--ageco-gray-dark)]')= lead
		if block
			div(class='flex flex-wrap gap-3')
				block

mixin dataTableToolbar(searchId, placeholder)
	-
		const actionClass = 'inline-flex items-center justify-center gap-2 rounded-md border border-[var(--border-soft)] bg-white px-3 py-2 text-xs font-semibold text-[var(--ageco-black)] no-underline transition-colors [@media(hover:hover)_and_(pointer:fine)]:hover:border-[var(--sigo-green)] [@media(hover:hover)_and_(pointer:fine)]:hover:text-[var(--sigo-green)]'
	div(class='data-table__toolbar mb-4 flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between')
		div(class='flex min-w-0 flex-1 flex-col gap-2 m:flex-row m:items-center')
			label(class='sr-only', for=searchId) Buscar en la tabla
			input(
				class='data-table__search w-full max-w-md rounded-md border border-[var(--border-soft)] bg-white px-3 py-2.5 text-sm outline-none focus:border-[var(--ageco-red)] focus:ring-2 focus:ring-[color-mix(in_srgb,var(--ageco-red)_25%,transparent)]',
				id=searchId,
				type='search',
				placeholder=placeholder || 'Buscar en la tabla…',
				autocomplete='off',
				spellcheck='false',
				data-data-table-search='true'
			)
			p(class='data-table__count m-0 shrink-0 text-sm text-[var(--ageco-gray-dark)]', data-data-table-count='true') —
		div(class='data-table__actions flex flex-wrap gap-2')
			button(class=actionClass, type='button', data-data-table-print='true') Imprimir
			button(class=actionClass, type='button', data-data-table-excel='true') Excel
			button(class=actionClass, type='button', data-data-table-whatsapp='true') WhatsApp
	//- La paginación (Anterior / páginas / Siguiente + filas por página) la inyecta dataTable.js

mixin dataTableSortHeader(label, colIndex)
	th(class='px-4 py-3 font-semibold whitespace-nowrap')
		button(
			class='inline-flex items-center gap-1 border-0 bg-transparent p-0 font-semibold text-inherit',
			type='button',
			data-data-table-sort=String(colIndex),
			aria-sort='none'
		)
			= label
			span(class='text-xs opacity-80', data-sort-indicator='true', aria-hidden='true')
