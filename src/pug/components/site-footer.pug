footer(
	class='site-footer mx-auto mt-auto w-full min-h-[var(--footer-height)] max-w-[var(--main-container)] border-t border-[var(--border-soft)] bg-[var(--ageco-gray)] px-[15px]'
)
	div(class='mx-auto flex w-full max-w-[var(--container)] flex-col gap-8 py-8 m:flex-row m:items-start m:justify-between')
		div(class='flex max-w-sm flex-col gap-4')
			a(class='inline-flex w-fit no-underline', href='./index.html', aria-label='AGECO')
				img(
					class='h-12 w-auto object-contain',
					src='./assets/ageco-logo.png',
					alt='Logo AGECO',
					width='182',
					height='120'
				)
			p(class='m-0 text-sm leading-relaxed text-[var(--ageco-gray-dark)]')
				| Asociación Gerontológica Costarricense. Prototipo CRM del programa Sigo Vigente.

		div(class='flex flex-col gap-2 text-sm')
			p(class='m-0 font-display font-bold text-[var(--ageco-black)]') Contacto
			p(class='m-0 text-[var(--ageco-gray-dark)]')= navData.footer.contacto.direccion
			a(class='text-[var(--ageco-red)]', href=`tel:${navData.footer.contacto.telefono}`)= navData.footer.contacto.telefono
			a(class='text-[var(--ageco-red)]', href=`mailto:${navData.footer.contacto.email}`)= navData.footer.contacto.email
			a(class='text-[var(--ageco-red)]', href=navData.footer.contacto.web, target='_blank', rel='noopener noreferrer') ageco.org

		div(class='flex flex-col gap-3')
			p(class='m-0 font-display font-bold text-[var(--ageco-black)]') Redes sociales
			ul(class='m-0 flex list-none gap-3 p-0')
				each red in navData.footer.redes
					li(class='m-0')
						a(
							class='inline-flex size-10 items-center justify-center rounded-full border border-[var(--border-soft)] bg-white text-[var(--sigo-green)] no-underline transition-colors [@media(hover:hover)_and_(pointer:fine)]:hover:border-[var(--sigo-green)] [@media(hover:hover)_and_(pointer:fine)]:hover:text-[var(--sigo-green-alt)] [@media(hover:hover)_and_(pointer:fine)]:hover:no-underline',
							href=red.href,
							target='_blank',
							rel='noopener noreferrer',
							aria-label=red.label
						)
							if red.icon === 'facebook'
								svg(class='size-5', fill='currentColor', viewBox='0 0 24 24', aria-hidden='true')
									path(d='M22 12a10 10 0 1 0-11.5 9.9v-7H8v-3h2.5V9.5c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.2c-1.2 0-1.6.8-1.6 1.5V12H16l-.4 3h-2.3v7A10 10 0 0 0 22 12z')
							else if red.icon === 'instagram'
								svg(class='size-5', fill='none', stroke='currentColor', viewBox='0 0 24 24', aria-hidden='true')
									path(stroke-linecap='round', stroke-linejoin='round', stroke-width='1.5', d='M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4z')
									path(stroke-linecap='round', stroke-linejoin='round', stroke-width='1.5', d='M12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8z')
									path(stroke-linecap='round', stroke-linejoin='round', stroke-width='1.5', d='M17.5 6.5h.01')
							else
								svg(class='size-5', fill='currentColor', viewBox='0 0 24 24', aria-hidden='true')
									path(d='M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31.5 31.5 0 0 0 0 12a31.5 31.5 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31.5 31.5 0 0 0 24 12a31.5 31.5 0 0 0-.5-5.8zM9.8 15.5v-7l6.2 3.5-6.2 3.5z')

	div(class='mx-auto w-full max-w-[var(--container)] border-t border-[var(--border-soft)] py-4')
		p(class='m-0 text-center text-xs text-[var(--ageco-gray-dark)]')
			| © AGECO — Prototipo estático Sigo Vigente. Datos de demostración.
