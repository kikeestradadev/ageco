include ui-mixins

-
	const perfilDefault = desempleadosData.items[0]

section(class='perfil-detalle mx-auto w-full max-w-[var(--main-container)] px-[15px]', data-perfil-tipo='desempleado')
	div(class='mx-auto w-full max-w-[var(--container)]')
		script#perfil-data(type='application/json')!= JSON.stringify(desempleadosData.items)

		div(class='mb-6')
			a(
				class='text-sm font-semibold text-[var(--ageco-red)] no-underline [@media(hover:hover)_and_(pointer:fine)]:hover:underline',
				href='./desempleados.html'
			) ← Volver a Desempleados

		+uiPageHeader(perfilDefault.nombre, 'Perfil de persona desempleada — programa Sigo Vigente')
			+uiButton('Asignar Capacitación', '#', 'primary')
			+uiButton('Registrar Asesoría', '#', 'secondary')
			+uiButton('Reportar Resultado Intermedio', '#', 'outline')

section(class='mx-auto w-full max-w-[var(--main-container)] px-[15px]')
	div(class='mx-auto grid w-full max-w-[var(--container)] gap-6 lg:grid-cols-[1.2fr_1fr]')
		article(class='rounded-lg border border-[var(--border-soft)] bg-white p-6 shadow-sm')
			h2(class='mb-4 font-display text-[length:var(--h3-size)] leading-[length:var(--h3-line)] font-semibold') Información personal
			dl(class='m-0 grid gap-4 sm:grid-cols-2')
				div
					dt(class='text-xs font-semibold tracking-wide text-[var(--ageco-gray-dark)] uppercase') Nombre
					dd(class='m-0 mt-1 font-semibold', data-field='nombre')= perfilDefault.nombre
				div
					dt(class='text-xs font-semibold tracking-wide text-[var(--ageco-gray-dark)] uppercase') Correo
					dd(class='m-0 mt-1', data-field='email')= perfilDefault.email
				div
					dt(class='text-xs font-semibold tracking-wide text-[var(--ageco-gray-dark)] uppercase') Teléfono
					dd(class='m-0 mt-1', data-field='telefono')= perfilDefault.telefono
				div
					dt(class='text-xs font-semibold tracking-wide text-[var(--ageco-gray-dark)] uppercase') Fecha de ingreso
					dd(class='m-0 mt-1', data-field='fechaIngreso')= perfilDefault.fechaIngreso
				div
					dt(class='text-xs font-semibold tracking-wide text-[var(--ageco-gray-dark)] uppercase') Estado
					dd(class='m-0 mt-1')
						span(data-field='estado')= perfilDefault.estado
				div
					dt(class='text-xs font-semibold tracking-wide text-[var(--ageco-gray-dark)] uppercase') Voluntario asignado
					dd(class='m-0 mt-1', data-field='voluntarioAsignado')= perfilDefault.voluntarioAsignado
				div
					dt(class='text-xs font-semibold tracking-wide text-[var(--ageco-gray-dark)] uppercase') Experiencia en limpieza
					dd(class='m-0 mt-1', data-field='experienciaLimpieza')= perfilDefault.experienciaLimpieza
				div
					dt(class='text-xs font-semibold tracking-wide text-[var(--ageco-gray-dark)] uppercase') Manipulación de armas
					dd(class='m-0 mt-1', data-field='manipulacionArmas')= perfilDefault.manipulacionArmas
				div
					dt(class='text-xs font-semibold tracking-wide text-[var(--ageco-gray-dark)] uppercase') Servicio al cliente
					dd(class='m-0 mt-1', data-field='servicioCliente')= perfilDefault.servicioCliente
				div
					dt(class='text-xs font-semibold tracking-wide text-[var(--ageco-gray-dark)] uppercase') Nivel de inglés
					dd(class='m-0 mt-1', data-field='nivelIngles')= perfilDefault.nivelIngles
				div
					dt(class='text-xs font-semibold tracking-wide text-[var(--ageco-gray-dark)] uppercase') Licencia
					dd(class='m-0 mt-1', data-field='licencia')= perfilDefault.licencia

		article(class='rounded-lg border border-[var(--border-soft)] bg-[var(--ageco-gray)] p-6')
			h2(class='mb-2 font-display text-[length:var(--h3-size)] leading-[length:var(--h3-line)] font-semibold') Progreso del plan
			p(class='mb-4 text-sm text-[var(--ageco-gray-dark)]')
				span(data-field='progreso')= perfilDefault.progreso
				| % del plan Sigo Vigente completado
			div(class='h-3 overflow-hidden rounded-full bg-white')
				div(
					class='h-full rounded-full bg-[var(--sigo-green)] transition-all',
					data-field='progresoBar',
					style=`width: ${perfilDefault.progreso}%`
				)

section(class='mx-auto w-full max-w-[var(--main-container)] px-[15px]')
	div(class='mx-auto w-full max-w-[var(--container)]')
		h2(class='mb-4 font-display text-[length:var(--h2-size)] leading-[length:var(--h2-line)] font-bold') Historial / Línea de tiempo
		div(class='grid gap-6 lg:grid-cols-3')
			article(class='rounded-lg border border-[var(--border-soft)] bg-white p-5')
				h3(class='mb-3 text-base font-semibold text-[var(--sigo-green)]') Capacitaciones
				ul(class='m-0 list-disc space-y-2 pl-5 text-sm', data-list='capacitaciones')
					each c in perfilDefault.capacitaciones
						li= c
			article(class='rounded-lg border border-[var(--border-soft)] bg-white p-5')
				h3(class='mb-3 text-base font-semibold text-[var(--sigo-green)]') Asesorías
				ul(class='m-0 list-disc space-y-2 pl-5 text-sm', data-list='asesorias')
					each a in perfilDefault.asesorias
						li= a
			article(class='rounded-lg border border-[var(--border-soft)] bg-white p-5')
				h3(class='mb-3 text-base font-semibold text-[var(--sigo-green)]') Resultados intermedios
				ul(class='m-0 list-disc space-y-2 pl-5 text-sm', data-list='resultadosIntermedios')
					each r in perfilDefault.resultadosIntermedios
						li= r
