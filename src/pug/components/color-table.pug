-
	const colors = [
		{ name: 'Rojo AGECO', hex: '#ED1B24', css: '--ageco-red', uso: 'Botones primarios, enlaces, acentos' },
		{ name: 'Rojo AGECO Alt', hex: '#C9141C', css: '--ageco-red-alt', uso: 'Hover de primario' },
		{ name: 'Verde Sigo Vigente', hex: '#007F66', css: '--sigo-green', uso: 'Secundario, badges, KPIs' },
		{ name: 'Verde Sigo Alt', hex: '#006651', css: '--sigo-green-alt', uso: 'Hover de secundario' },
		{ name: 'Negro', hex: '#000000', css: '--ageco-black', uso: 'Textos y títulos' },
		{ name: 'Blanco', hex: '#FFFFFF', css: '--ageco-white', uso: 'Fondos y texto sobre color' },
		{ name: 'Gris Claro', hex: '#F5F5F5', css: '--ageco-gray', uso: 'Fondos de sección y tarjetas' },
		{ name: 'Gris Medio', hex: '#E0E0E0', css: '--ageco-gray-mid', uso: 'Bordes y divisores' },
		{ name: 'Gris Oscuro', hex: '#666666', css: '--ageco-gray-dark', uso: 'Textos secundarios' },
	]

section#colores(class='mx-auto w-full max-w-[var(--main-container)] px-[15px]')
	div(class='mx-auto w-full max-w-[var(--container)]')
		h2(class='mb-2 font-display text-[length:var(--h2-size)] leading-[length:var(--h2-line)] font-bold') Colores de marca
		p(class='mb-8 text-[length:var(--p-size)] leading-[length:var(--p-line)] text-[var(--ageco-gray-dark)]')
			| Paleta AGECO y Sigo Vigente. Tokens en
			code(class='mx-1 rounded bg-[var(--ageco-gray)] px-1') :root
			|  y consumo con
			code(class='mx-1 rounded bg-[var(--ageco-gray)] px-1') propiedad-[var(--token)]
			| .

		div(class='mb-10 grid grid-cols-1 gap-5 sm:grid-cols-2 m:grid-cols-3 l:grid-cols-4 lg:grid-cols-5')
			each color in colors
				article(class='overflow-hidden rounded-lg border border-[var(--border-soft)] bg-white shadow-sm')
					div(
						class=`h-24 ${color.hex === '#FFFFFF' ? 'border-b border-[var(--border-soft)]' : ''}`,
						style=`background-color: ${color.hex}`
					)
					div(class='space-y-1 p-4')
						h3(class='m-0 text-base font-bold text-[var(--ageco-black)]')= color.name
						p(class='m-0 text-sm text-[var(--ageco-gray-dark)]')= color.hex
						p(class='m-0 text-xs text-[var(--ageco-gray-dark)]')
							code(class='rounded bg-[var(--ageco-gray)] px-1 font-mono text-[var(--ageco-red)]')= color.css
						p(class='m-0 pt-1 text-xs text-[var(--ageco-gray-dark)]')= color.uso

		h3(class='mb-4 font-display text-[length:var(--h3-size)] leading-[length:var(--h3-line)] font-semibold') Ejemplos de uso
		div(class='grid gap-4 m:grid-cols-2 lg:grid-cols-4')
			p(class='m-0 rounded-md bg-[var(--ageco-gray)] p-4 text-[var(--ageco-red)]') Texto en Rojo AGECO
			p(class='m-0 rounded-md bg-[var(--sigo-green)] p-4 text-white') Fondo Verde Sigo Vigente
			p(class='m-0 rounded-md border-2 border-[var(--ageco-red)] bg-white p-4 text-[var(--ageco-black)]') Borde Rojo AGECO
			p(class='m-0 rounded-md border border-[var(--border-soft)] bg-[var(--ageco-gray)] p-4 text-[var(--ageco-black)]') Fondo Gris Claro
